# StudySync backend configuration
#
# Copy this file to backend/.env and fill in the values
# for your own machine. Never commit backend/.env.

PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=studysync

# Session token signing key (PB-02).
# Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is unset the server generates a temporary key
# and every session ends when the server restarts.
JWT_SECRET=

# How long a session lasts before it must be renewed.
JWT_EXPIRES_IN=8h
